+#if WASM
+static u32 ClampRunExperienceGain(u16 species, u32 currentExp, u32 expGain, u32 levelCap)
+{
+    u32 nextLevel;
+    u32 capExp;
+    if (levelCap == 0 || levelCap >= MAX_LEVEL || species == SPECIES_NONE)
+        return expGain;
+    nextLevel = levelCap + 1;
+    capExp = gExperienceTables[gSpeciesInfo[species].growthRate][nextLevel];
+    if (capExp > 0)
+        capExp--;
+    if (currentExp >= capExp)
+        return 0;
+    if (expGain > capExp - currentExp)
+        return capExp - currentExp;
+    return expGain;
+}
+
+u32 WasmRunDebugApplyExpGain(u32 index, u32 expGain)
+{
+    struct Pokemon *mon;
+    u16 species;
+    u32 currentExp;
+    u32 gained;
+    u32 nextExp;
+    if (index >= PARTY_SIZE)
+        return 0;
+    mon = &gPlayerParty[index];
+    species = GetMonData(mon, MON_DATA_SPECIES, NULL);
+    if (species == SPECIES_NONE)
+        return 0;
+    currentExp = GetMonData(mon, MON_DATA_EXP, NULL);
+    gained = ClampRunExperienceGain(species, currentExp, expGain, WasmRunGymLevelCap());
+    nextExp = currentExp + gained;
+    SetMonData(mon, MON_DATA_EXP, &nextExp);
+    CalculateMonStats(mon);
+    return GetMonData(mon, MON_DATA_LEVEL, NULL);
+}
+#endif
